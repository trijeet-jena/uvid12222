{
  "name": "uvid-store-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "deploy": "wrangler --config wrangler.toml deploy",
    "db:init": "wrangler --config wrangler.toml d1 execute uvid-store --remote --file=schema.sql",
    "db:seed": "wrangler --config wrangler.toml d1 execute uvid-store --remote --file=seed-catalog.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  }
}
